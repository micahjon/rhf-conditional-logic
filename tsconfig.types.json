{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "tests-types", "tests-unit", "tests-e2e"],
  "exclude": ["node_modules"]
}
